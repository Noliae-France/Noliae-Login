@model(titre: Text)
<!doctype html><html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>@titre</title><link rel="stylesheet" href="/static/noliae.css"></head><body><main class="login-shell"><aside class="welcome"><div class="welcome-mid"><h1>Retrouvons<br>votre accès.</h1><p>Saisissez votre adresse e-mail. Un lien sécurisé sera envoyé si le compte existe.</p></div></aside><section class="login-panel"><div class="form-stage"><div class="form-head"><h2>Mot de passe oublié ?</h2></div><form id="reset-form"><label for="email">Adresse e-mail</label><input id="email" name="email" type="email" required><button class="submit">Envoyer le lien <span>→</span></button></form><p id="status" class="create" role="status"></p><p class="create"><a href="/">Retour à la connexion</a></p></div></section></main><script>(async()=>{const h=location.hostname,a=h.startsWith("login.")?location.protocol+"//api."+h.slice(6):location.origin,f=document.getElementById("reset-form"),s=document.getElementById("status");f.onsubmit=async e=>{e.preventDefault();try{await fetch(a+"/v1/user/resetpassword",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({email:f.email.value})});s.textContent="Si cette adresse existe, un e-mail va être envoyé."}catch(_){s.textContent="Core indisponible. Réessayez."}}})();</script></body></html>
