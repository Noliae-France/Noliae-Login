fn vue_login(titre: Text) -> Text {
    var _o = ""
    _o += "<!doctype html>\n<html lang=\"fr\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"theme-color\" content=\"#FF5A36\"><title>"
    _o += html_escape(titre)
    _o += "</title><meta name=\"description\" content=\"Connexion sécurisée à votre compte Noliae.\"><meta name=\"robots\" content=\"noindex,nofollow\"><link rel=\"icon\" href=\"/static/favicon.svg\"><link rel=\"preconnect\" href=\"https://fonts.googleapis.com\"><link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin><link href=\"https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&family=Plus+Jakarta+Sans:wght@500;600;700&display=swap\" rel=\"stylesheet\"><link rel=\"stylesheet\" href=\"/static/noliae.css\"></head>\n<body><main class=\"login-shell\">\n<aside class=\"welcome\"><a class=\"brand\" href=\"/\" aria-label=\"Noliae\"><svg viewBox=\"0 0 140 100\" aria-hidden=\"true\"><rect x=\"12\" y=\"35\" width=\"10\" height=\"30\" rx=\"5\"/><rect x=\"30\" y=\"25\" width=\"10\" height=\"50\" rx=\"5\"/><rect x=\"48\" y=\"15\" width=\"10\" height=\"70\" rx=\"5\"/><rect class=\"pulse\" x=\"66\" y=\"22\" width=\"10\" height=\"56\" rx=\"5\"/><rect x=\"84\" y=\"20\" width=\"10\" height=\"60\" rx=\"5\"/><rect x=\"102\" y=\"30\" width=\"10\" height=\"40\" rx=\"5\"/><rect x=\"120\" y=\"35\" width=\"10\" height=\"30\" rx=\"5\"/></svg><span>noliae</span></a><div class=\"welcome-mid\"><h1>Content de te revoir.</h1><p>Retrouve tous tes services Noliae, là où tu les as laissés.</p><div class=\"features\"><article><span>✉</span><div><b>Ton adresse Noliae</b><small>Un seul identifiant pour huit services</small></div></article><article><span>♙</span><div><b>Chiffré et hébergé en France</b><small>Tes données restent chez toi</small></div></article><article><span>♧</span><div><b>Connexion sans mot de passe</b><small>Passkey, Touch ID ou Face ID</small></div></article></div></div></aside>\n<section class=\"login-panel\"><header><nav class=\"tabs\" aria-label=\"Compte\"><a class=\"active\" href=\"/\">Connexion</a><a href=\"/\">Créer un compte</a></nav><p class=\"language\"><b>FR</b><span>·</span><a href=\"#\">EN</a></p></header><div class=\"form-stage\"><div class=\"form-head\"><h2>Bon retour.</h2><p>Connecte-toi pour reprendre où tu en étais.</p></div><button class=\"passkey\" type=\"button\"><i>♙</i><span><b>Continuer avec une passkey</b><small>Le plus rapide · Touch ID ou Face ID</small></span><em>→</em></button><div class=\"divider\"><span>ou avec ton adresse</span></div><form action=\"/v1/user/login\" method=\"post\"><label for=\"email\">Ton adresse e-mail</label><input id=\"email\" type=\"email\" name=\"email\" autocomplete=\"email\" placeholder=\"vous@noliae.com\" required><div class=\"label-line\"><label for=\"password\">Mot de passe</label><button type=\"button\" class=\"reveal\">Afficher</button></div><input id=\"password\" type=\"password\" name=\"password\" autocomplete=\"current-password\" placeholder=\"••••••••\" required><div id=\"mfa-row\" hidden><label for=\"otp\">Code d'authentification (2FA)</label><input id=\"otp\" name=\"otp\" inputmode=\"numeric\" autocomplete=\"one-time-code\" placeholder=\"123 456\"></div><p id=\"err\" style=\"color:#c0392b;font-size:13px;margin:6px 0\" hidden></p><button class=\"submit\" type=\"submit\">Se connecter <span>→</span></button></form><div class=\"links\"><p>Pas encore de compte ? <a href=\"/\">Créer un compte</a></p><a href=\"/reset\">Mot de passe oublié</a></div></div><footer><span>© Noliae · Hébergé en France</span><span><a href=\"#\">Confidentialité</a> · <a href=\"#\">Aide</a></span></footer></section>\n</main><script>(async()=>{const host=location.hostname;const api=host.startsWith(\"login.\")?location.protocol+\"//api.\"+host.slice(6):location.origin;let ACCT=\"/\";const errEl=document.getElementById(\"err\"),err=m=>{errEl.textContent=m||\"\";errEl.hidden=!m};const done=()=>{location.href=ACCT};const b2b=s=>{s=s.replace(/-/g,\"+\").replace(/_/g,\"/\");while(s.length%4)s+=\"=\";const b=atob(s),u=new Uint8Array(b.length);for(let i=0;i<b.length;i++)u[i]=b.charCodeAt(i);return u.buffer};const b64=b=>{const u=new Uint8Array(b);let s=\"\";for(const x of u)s+=String.fromCharCode(x);return btoa(s).replace(/\\+/g,\"-\").replace(/\\//g,\"_\").replace(/=+$/,\"\")};try{const r=await fetch(api+\"/v1/branding\");if(r.ok){const b=await r.json();const n=b.name||\"NolCore\";document.title=\"Connexion — \"+n;ACCT=b.account_url||\"/\";document.querySelectorAll(\"a\").forEach(a=>{if(a.href.includes(\"register.\"))a.href=b.register_url||a.href;if(a.href.includes(\"noliae.com\")&&!a.href.includes(\"register.\"))a.href=b.website_url||a.href});document.querySelectorAll(\"footer span\").forEach(x=>{if(x.textContent.includes(\"Noliae\"))x.textContent=x.textContent.replace(\"Noliae\",n)})}}catch(_){}\nconst form=document.querySelector(\"form\");form.onsubmit=async e=>{e.preventDefault();err(\"\");const email=document.getElementById(\"email\").value,password=document.getElementById(\"password\").value,otp=(document.getElementById(\"otp\")||{}).value||\"\";const p={email,password};if(otp)p.otp=otp;let r,o;try{r=await fetch(api+\"/v1/user/login\",{method:\"POST\",credentials:\"include\",headers:{\"content-type\":\"application/json\"},body:JSON.stringify(p)});o=await r.json().catch(()=>({}))}catch(_){err(\"Connexion impossible.\");return}if(r.ok){done();return}if(o.title===\"MFA Required\"||(o.detail||\"\").indexOf(\"deux facteurs\")>=0){document.getElementById(\"mfa-row\").hidden=false;document.getElementById(\"otp\").focus();err(\"Entre ton code d'authentification.\");return}err(o.detail||\"Identifiants invalides.\")};\nconst pk=document.querySelector(\".passkey\");if(pk)pk.onclick=async()=>{err(\"\");const email=document.getElementById(\"email\").value;if(!email){err(\"Entre ton adresse pour utiliser une passkey.\");document.getElementById(\"email\").focus();return}let r,o;try{r=await fetch(api+\"/v1/auth/passkey/login/begin\",{method:\"POST\",credentials:\"include\",headers:{\"content-type\":\"application/json\"},body:JSON.stringify({email})});o=await r.json()}catch(_){err(\"Passkey indisponible.\");return}if(!r.ok){err(o.detail||\"Passkey indisponible.\");return}const pub={challenge:b2b(o.challenge),rpId:o.rpId,userVerification:o.userVerification||\"preferred\",timeout:o.timeout||60000,allowCredentials:(o.allowCredentials||[]).map(c=>({type:\"public-key\",id:b2b(c.id)}))};let cred;try{cred=await navigator.credentials.get({publicKey:pub})}catch(_){err(\"Passkey annulée.\");return}const body={id:cred.id,rawId:b64(cred.rawId),type:cred.type,response:{clientDataJSON:b64(cred.response.clientDataJSON),authenticatorData:b64(cred.response.authenticatorData),signature:b64(cred.response.signature),userHandle:cred.response.userHandle?b64(cred.response.userHandle):null}};let r2,o2;try{r2=await fetch(api+\"/v1/auth/passkey/login/finish\",{method:\"POST\",credentials:\"include\",headers:{\"content-type\":\"application/json\"},body:JSON.stringify(body)});o2=await r2.json().catch(()=>({}))}catch(_){err(\"Connexion passkey échouée.\");return}if(r2.ok){done()}else{err(o2.detail||\"Connexion passkey échouée.\")}};})();</script></body></html>\n"
    return _o
}
