@model(titre: Text)
<!doctype html>
<html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#FF5A36"><title>@titre</title><meta name="description" content="Connexion sécurisée à votre compte Noliae."><meta name="robots" content="noindex,nofollow"><link rel="icon" href="/static/favicon.svg"><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@@9..40,400;9..40,500;9..40,600&family=Plus+Jakarta+Sans:wght@@500;600;700&display=swap" rel="stylesheet"><link rel="stylesheet" href="/static/noliae.css"></head>
<body><main class="login-shell">
<aside class="welcome"><a class="brand" href="https://noliae.com" aria-label="Noliae"><svg viewBox="0 0 140 100" aria-hidden="true"><rect x="12" y="35" width="10" height="30" rx="5"/><rect x="30" y="25" width="10" height="50" rx="5"/><rect x="48" y="15" width="10" height="70" rx="5"/><rect class="pulse" x="66" y="22" width="10" height="56" rx="5"/><rect x="84" y="20" width="10" height="60" rx="5"/><rect x="102" y="30" width="10" height="40" rx="5"/><rect x="120" y="35" width="10" height="30" rx="5"/></svg><span>noliae</span></a><div class="welcome-mid"><h1>Content de te revoir.</h1><p>Retrouve tous tes services Noliae, là où tu les as laissés.</p><div class="features"><article><span>✉</span><div><b>Ton adresse Noliae</b><small>Un seul identifiant pour huit services</small></div></article><article><span>♙</span><div><b>Chiffré et hébergé en France</b><small>Tes données restent chez toi</small></div></article><article><span>♧</span><div><b>Connexion sans mot de passe</b><small>Passkey, Touch ID ou Face ID</small></div></article></div></div><div class="proof"><span class="avatars"><i>L</i><i>M</i><i>A</i><i>S</i></span><p><b>40 000 personnes</b> utilisent Noliae chaque jour</p></div></aside>
<section class="login-panel"><header><nav class="tabs" aria-label="Compte"><a class="active" href="/">Connexion</a><a href="https://register.noliae.com">Créer un compte</a></nav><p class="language"><b>FR</b><span>·</span><a href="#">EN</a></p></header><div class="form-stage"><div class="form-head"><h2>Bon retour.</h2><p>Connecte-toi pour reprendre où tu en étais.</p></div><button class="passkey" type="button"><i>♙</i><span><b>Continuer avec une passkey</b><small>Le plus rapide · Touch ID ou Face ID</small></span><em>→</em></button><div class="divider"><span>ou avec ton adresse</span></div><form action="/v1/user/login" method="post"><label for="email">Ton adresse e-mail</label><input id="email" type="email" name="email" autocomplete="email" placeholder="vous@@noliae.com" required><div class="label-line"><label for="password">Mot de passe</label><button type="button" class="reveal">Afficher</button></div><input id="password" type="password" name="password" autocomplete="current-password" placeholder="••••••••" required><button class="submit" type="submit">Se connecter <span>→</span></button></form><div class="links"><p>Pas encore de compte ? <a href="https://register.noliae.com">Créer un compte</a></p><a href="/reset">Mot de passe oublié</a></div></div><footer><span>© Noliae · Hébergé en France</span><span><a href="#">Confidentialité</a> · <a href="#">Aide</a></span></footer></section>
</main><script>(async()=>{const host=location.hostname;const api=host.startsWith("login.")?location.protocol+"//api."+host.slice(6):location.origin;try{const r=await fetch(api+"/v1/branding");if(!r.ok)return;const b=await r.json();const n=b.name||"NolCore";document.title="Connexion — "+n;document.querySelectorAll("a").forEach(a=>{if(a.href.includes("register."))a.href=b.register_url||a.href;if(a.href.includes("noliae.com")&&!a.href.includes("register."))a.href=b.website_url||a.href});document.querySelectorAll(".brand span").forEach(x=>x.textContent=n);document.querySelectorAll("footer span").forEach(x=>{if(x.textContent.includes("Noliae"))x.textContent=x.textContent.replace("Noliae",n)})}catch(_){}})();</script></body></html>
