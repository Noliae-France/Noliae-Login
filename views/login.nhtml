@model(titre: Text)
<!doctype html><html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>@titre</title><meta name="description" content="Connexion sécurisée Noliae."><meta name="robots" content="noindex,nofollow"><link rel="stylesheet" href="/static/noliae.css"></head><body><header><a href="/" class="brand">▂▅█▇█▅▂ <span>noliae</span></a><p>Nouveau sur Noliae ? <a href="https://register.noliae.com">Créer un compte →</a></p></header><main><section class="intro"><p class="cap"><i></i> Noliae compte</p><h1>Content de<br>vous <em>revoir.</em></h1><p>Connectez-vous une fois. Votre session sécurisée vous accompagne sur l’ensemble de Noliae.</p><div class="security"><b>●</b><span>Cookie HttpOnly signé<br><small>valable 24 heures, lié à votre session</small></span></div></section><section class="card"><p class="cap">Connexion</p><h2>Votre espace.</h2><form action="/v1/user/login" method="post"><label>Adresse e-mail<input type="email" name="email" autocomplete="email" required></label><label>Mot de passe<input type="password" name="password" autocomplete="current-password" required></label><a class="forgot" href="/reset">Mot de passe oublié ?</a><button>Se connecter <b>→</b></button></form><p class="switch">Pas encore de compte ? <a href="https://register.noliae.com">Créer un compte</a></p></section></main><footer>© Noliae · Connexion chiffrée</footer></body></html>
