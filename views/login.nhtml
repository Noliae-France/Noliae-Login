@model(titre: Text)
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="#111111">
  <title>@titre</title>
  <meta name="description" content="Connexion sécurisée à votre compte Noliae.">
  <meta name="robots" content="noindex,nofollow">
  <link rel="icon" href="/static/favicon.svg">
  <link rel="stylesheet" href="/static/noliae.css">
  <style>@@keyframes noliae-rise{from{opacity:0;transform:translateY(18px)}to{opacity:1;transform:translateY(0)}}@@keyframes noliae-pulse{50%{opacity:.45;transform:scale(.78)}}.auth-story>*{animation:noliae-rise .65s cubic-bezier(.2,.8,.2,1) both}.auth-story h1{animation-delay:.08s}.auth-story .story-copy{animation-delay:.16s}.trust-card{animation-delay:.24s}.product-links{animation-delay:.32s}.auth-panel{animation:noliae-rise .7s cubic-bezier(.2,.8,.2,1) .18s both}.trust-dot{animation:noliae-pulse 1.8s ease-in-out infinite}.brand img{transition:transform .25s cubic-bezier(.2,.8,.2,1)}.brand:hover img{transform:rotate(-5deg) scale(1.08)}button{transition:transform .18s ease,background .18s ease,box-shadow .18s ease}button:hover{transform:translateY(-2px);box-shadow:0 8px 18px rgba(255,77,46,.18)}input{transition:border-color .18s ease,box-shadow .18s ease,background .18s ease}@@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}}</style>
</head>
<body>
  <header class="topbar">
    <a href="/" class="brand" aria-label="Noliae"><img src="/static/symbol-dark.svg" alt=""><span>noliae</span></a>
    <p>Nouveau sur Noliae ? <a href="https://register.noliae.com">Créer un compte <b>→</b></a></p>
  </header>
  <main class="auth-shell">
    <section class="auth-story">
      <p class="eyebrow"><i></i> Noliae compte</p>
      <h1>Content de<br>vous <em>revoir.</em></h1>
      <p class="story-copy">Connectez-vous une fois. Votre session sécurisée vous accompagne sur l’ensemble de Noliae.</p>
      <div class="trust-card"><span class="trust-dot"></span><div><strong>Session Noliae protégée</strong><p>Cookie HttpOnly signé, valable 24 heures et lié à votre session.</p></div></div>
      <div class="product-links"><a href="https://noliae.com"><span>⌕</span> Search</a><a href="https://ia.noliae.com"><span>✦</span> Noliae IA</a><a href="https://account.noliae.com"><span>◌</span> Account</a></div>
    </section>
    <section class="auth-panel">
      <div class="panel-heading"><p class="eyebrow">Connexion</p><h2>Votre espace.</h2><p>Utilisez votre adresse e-mail Noliae.</p></div>
      <form action="/v1/user/login" method="post">
        <label for="email">Adresse e-mail</label><input id="email" type="email" name="email" autocomplete="email" placeholder="vous@@noliae.com" required>
        <div class="label-row"><label for="password">Mot de passe</label><a href="/reset">Mot de passe oublié ?</a></div><input id="password" type="password" name="password" autocomplete="current-password" required>
        <button type="submit">Se connecter <b>→</b></button>
      </form>
      <p class="create">Pas encore de compte ? <a href="https://register.noliae.com">Créer un compte</a></p>
      <p class="security-note"><i>✓</i> Connexion chiffrée et contrôlée par NolCore.</p>
    </section>
  </main>
  <footer class="site-footer"><span>© Noliae</span><a href="https://noliae.com">noliae.com</a><span>Connexion sécurisée</span></footer>
</body>
</html>
